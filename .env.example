# Anthropic (required for LLM-arbitrated diagnosis; the heuristic ranker runs without it)
ANTHROPIC_API_KEY=sk-ant-...
INCIDENTPILOT_MODEL=claude-opus-5
INCIDENTPILOT_EFFORT=high

# Repo under investigation
INCIDENTPILOT_REPO=/repo

# Optional: Voyage embeddings for RAG. Without it, the hashed-TFIDF backend is used.
VOYAGE_API_KEY=

# Slack. Posting is OFF unless INCIDENTPILOT_SLACK_POST=1 AND a token is present.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=#incidents
INCIDENTPILOT_SLACK_POST=0

# Webhook auth
INCIDENTPILOT_WEBHOOK_TOKEN=change-me
