#!/bin/sh
# Refuse any commit whose author or committer is not the identity this repo is
# configured with.
#
# Repo-local user.name/user.email are not sufficient on their own: GIT_AUTHOR_EMAIL and
# GIT_COMMITTER_EMAIL environment variables override them, and IDEs, CI and agent tooling
# set those. `git var` resolves the identity that will actually be recorded, after every
# override, so comparing the two catches exactly that case.
#
# No identity is hardcoded here -- the expected value is whatever `git config user.email`
# says, so this file carries no personal data and works in any clone.
#
# Enable with:  git config core.hooksPath .githooks

expected=$(git config user.email)

if [ -z "$expected" ]; then
    echo "pre-commit: no user.email configured for this repository." >&2
    echo "  Set one before committing:  git config user.email \"you@example.com\"" >&2
    exit 1
fi

author=$(git var GIT_AUTHOR_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')
committer=$(git var GIT_COMMITTER_IDENT | sed -n 's/.*<\(.*\)>.*/\1/p')

fail() {
    echo "pre-commit: refusing to commit as the wrong identity." >&2
    echo "  $1 resolves to: $2" >&2
    echo "  but this repo is configured for: $expected" >&2
    echo >&2
    echo "  Something is overriding the repository config. Check for" >&2
    echo "  GIT_AUTHOR_EMAIL / GIT_COMMITTER_EMAIL in your environment." >&2
    exit 1
}

[ "$author" = "$expected" ] || fail "author" "$author"
[ "$committer" = "$expected" ] || fail "committer" "$committer"
